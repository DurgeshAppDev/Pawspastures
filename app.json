{
  "expo": {
    "name": "Paws & Pastures",
    "slug": "PawsPastures",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pawspastures",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pawspastures.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Paws & Pastures needs camera access so you can take photos and videos for your pets.",
        "NSMicrophoneUsageDescription": "Paws & Pastures needs microphone access so you can record videos with sound.",
        "NSPhotoLibraryUsageDescription": "Paws & Pastures needs photo library access so you can select photos and videos for your pets."
      }
    },

    "android": {
      "package": "com.pawspastures.app",
      "googleServicesFile": "./google-services.json",

      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],

      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },

    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },

    "extra": {
      "eas": {
        "projectId": "9f682ef6-cf3d-44f7-8269-b26327761384"
      }
    },

    "plugins": [
      "expo-font",
      "expo-notifications",
      "@react-native-google-signin/google-signin",
      "expo-camera",
      "expo-image-picker"
    ]
  }
}